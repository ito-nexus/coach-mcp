    "express": "5.2.1",
    "express-rate-limit": "8.2.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.8",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
