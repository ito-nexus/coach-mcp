{
  "name": "coach-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server that lets Claude search Fathom coaching calls stored in Supabase",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
